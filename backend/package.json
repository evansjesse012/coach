{
  "name": "coach-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Coach backend API — the server seam in front of Postgres (see ../BACKEND_FOUNDATION_PLAN.md)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
