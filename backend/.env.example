# Copy to .env for local dev, or set these as environment variables in Railway.
# Do NOT commit a real .env — it is gitignored.

# Postgres connection (Supabase → Settings → Database → Connection string).
# Use the POOLED connection string for a long-lived service.
# Format: postgresql://postgres.<ref>:<password>@<host>:6543/postgres
DATABASE_URL=

# Supabase project URL and anon key (Supabase → Settings → API).
# Used to verify the app's JWT by calling ${SUPABASE_URL}/auth/v1/user,
# matching how the existing edge function authenticates requests.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Port the HTTP server listens on. Railway sets PORT automatically.
PORT=8080

# Anthropic key — only needed once the agent loop moves server-side (Phase 4).
# Leave empty until then.
ANTHROPIC_API_KEY=
